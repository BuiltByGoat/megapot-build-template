{
  "name": "megapot-build",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "megapot.build — factory for BuiltByGoat/network-site-template. Attribution stays in private env.",
  "scripts": {
    "dev": "next dev",
    "build": "SITE_HOSTNAME=${SITE_HOSTNAME:-megapot.build} next build && tsx scripts/write-pages-routes.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "privacy": "node scripts/check-privacy.mjs",
    "utms": "tsx scripts/check-utms.mjs",
    "go": "tsx scripts/check-go.mjs",
    "seo": "tsx scripts/check-seo.mjs",
    "test": "tsx --test src/lib/*.test.ts",
    "check": "biome check && pnpm typecheck && pnpm test && pnpm privacy && pnpm build && pnpm utms --generated && pnpm go && pnpm seo"
  },
  "dependencies": {
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}

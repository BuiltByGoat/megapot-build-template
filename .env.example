# ─────────────────────────────────────────────────────────────────────────────
# megapot.build — private attribution + public site labels
#
# Copy this file to .env.local for Next.js, or set the same NAMES on
# Cloudflare Pages (Settings → Environment variables). Documented here
# as NAMES only. Never commit values. Never put secrets in NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────────

# Public site title shown in the factory chrome. Safe to expose.
NEXT_PUBLIC_SITE_NAME=

# Server-only. Destination the /go Pages Function redirects to.
# Bind this on Cloudflare Pages so public markup never contains an invite
# path, referral code, or wallet. Leave empty to fall back to https://megapot.io
MEGAPOT_PLAY_DESTINATION=

# Server-only. Operator wallet for a future on-chain app template.
# Not read by the marketing shell. Never prefix with NEXT_PUBLIC_ or VITE_.
MEGAPOT_REFERRER_ADDRESS=

# Server-only. Megapot Data API key if a fork adds server-side reads.
# Mint from the Megapot dashboard. Never prefix with NEXT_PUBLIC_ or VITE_.
MEGAPOT_API_KEY=
